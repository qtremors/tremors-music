#include <windows.h>
1 ICON "@ICON@"
1 VERSIONINFO
FILEVERSION @NUMERIC_VERSION@
PRODUCTVERSION @NUMERIC_VERSION@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Tremors\0"
            VALUE "FileDescription", "Tremors Music\0"
            VALUE "FileVersion", "@VERSION@\0"
            VALUE "InternalName", "tremors-music\0"
            VALUE "LegalCopyright", "Copyright (c) 2025-2026 Tremors\0"
            VALUE "OriginalFilename", "tremors-music.exe\0"
            VALUE "ProductName", "Tremors Music\0"
            VALUE "ProductVersion", "@VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
